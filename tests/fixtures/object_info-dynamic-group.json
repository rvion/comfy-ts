   "LoadLoraModel": {
      "input": {
         "required": {
            "model": [
               "MODEL",
               {
                  "tooltip": "The diffusion model the LoRAs will be applied to."
               }
            ],
            "loras": [
               "COMFY_DYNAMICGROUP_V3",
               {
                  "tooltip": "Each row applies one LoRA to the model.",
                  "template": {
                     "required": {
                        "lora_name": [
                           "COMBO",
                           {
                              "tooltip": "The name of the LoRA file to apply.",
                              "multiselect": false,
                              "options": [
                                 "style_a.safetensors",
                                 "style_b.safetensors",
                                 "detail.safetensors"
                              ]
                           }
                        ],
                        "strength": [
                           "FLOAT",
                           {
                              "tooltip": "How strongly to apply this LoRA. 0 = off, negative inverts the effect.",
                              "default": 1,
                              "min": -100,
                              "max": 100,
                              "step": 0.01
                           }
                        ],
                        "enabled": [
                           "BOOLEAN",
                           {
                              "tooltip": "Turn off to skip this LoRA without changing its file or strength.",
                              "default": true
                           }
                        ]
                     }
                  },
                  "min": 1,
                  "max": 20,
                  "group_name": "LoRA"
               }
            ]
         }
      },
      "input_order": {
         "required": [
            "model",
            "loras"
         ]
      },
      "is_input_list": false,
      "output": [
         "MODEL"
      ],
