{
   // ONE tsconfig at the repo root. tsc only typechecks (noEmit) —
   // tsdown emits dist/ for npm, bun runs scripts/tests directly.
   "compilerOptions": {
      // real node resolution — what tsc resolves is what bun resolves at runtime
      "module": "nodenext",
      "moduleResolution": "nodenext",

      // the pair that legalizes `from 'src/foo/Bar.ts'` — extensions are part
      // of the exact-path search key; tsc only typechecks, bun/tsdown emit
      "allowImportingTsExtensions": true,
      "noEmit": true,

      // THE mapping that makes 'src/...' specifiers resolve. No baseUrl —
      // explicit paths only, so bare specifiers can't collide with packages.
      "paths": {
         "src/*": ["./src/*"],
         "scripts/*": ["./scripts/*"],
         "tests/*": ["./tests/*"],
         "examples/*": ["./examples/*"],
         // lets the generated .comfy-ts/hosts/*/sdk.d.ts import 'comfy-ts'
         // in-repo exactly like consumers do from node_modules
         "comfy-ts": ["./src/index.ts"]
      },

      // every file is a module even with no import/export (standalone scripts)
      "moduleDetection": "force",

      "strict": true,
      "noUncheckedIndexedAccess": true,
      "isolatedModules": true,
      "skipLibCheck": true,
      "incremental": true,
      "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",

      "resolveJsonModule": true,

      // explicit: tsgo does not reliably auto-include @types/bun's `bun:test`
      // module declaration (surfaced when the tui tests joined the project)
      "types": ["node", "bun", "react", "ws"],

      "jsx": "react-jsx"
   },
   // tests/ have their OWN config (tsconfig.tests.json): they drive schema-less hosts whose
   // base builder is index-typed, so they are checked without noUncheckedIndexedAccess.
   // the one test listed here imports a workflow module, which needs the generated host sdk
   "include": ["src", "scripts", "examples", "tests/anima-example.test.ts", ".comfy-ts/hosts/**/sdk.d.ts", "*.ts"],
   // dom-typed corners have their OWN configs (dom lib): `bun run typecheck` chains
   // both, `typecheck:lib` chains src/cli/serve/web
   "exclude": ["examples/web", "examples/depth-explorer/web", "examples/world-explorer/web", "examples/upscale-explorer/web", "examples/explorer-kit/web", "src/cli/serve/web"]
}
