{
   // the PORTABLE gate (what GitHub CI runs): library + scripts only, no host
   // sdk.d.ts on disk. examples/ are excluded ON PURPOSE — they call nodes
   // (`b.KSampler`) and name model files that only exist in a GENERATED per-host
   // sdk, so without one they are index-typed and possibly-undefined, exactly
   // like tests/ (see the root tsconfig). Typecheck them locally with
   // `bun run typecheck` after `bun run gen:sdk`.
   "extends": "./tsconfig.json",
   // its OWN incremental cache: sharing the root's meant an editor typechecking with the
   // root config (a different include set) invalidated this one mid-flight, and the gate
   // reported a phantom error — a red gate on green code is worse than a slow one
   "compilerOptions": { "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo-lib.json" },
   "include": ["src", "scripts", "*.ts"]
}
