// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "starts everything",
            "dependsOn": ["👁  TSC", "🤖  comfy panel"],
            "group": { "kind": "build", "isDefault": true },
            "runOptions": { "runOn": "folderOpen", "instanceLimit": 1 },
            "problemMatcher": []
        },
        {
            "label": "👁  TSC",
            "detail": "Get all typescript errors in problems pane",
            "type": "process",
            "options": { "env": { "NODE_OPTIONS": "--max-old-space-size=8192" } },
            "command": "./node_modules/.bin/tsc",
            "args": ["--watch", "--noEmit", "--preserveWatchOutput", "--incremental"],
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": { "reveal": "never", "clear": true },
            "group": "build",
            "runOptions": { "instanceLimit": 1 }
        },
        {
            "label": "🤖  comfy panel",
            "detail": "comfy-ts web panel over examples/rvion at http://127.0.0.1:8288 (restarts when a module changes)",
            "type": "process",
            "command": "bun",
            "args": ["run", "serve:rvion"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": { "reveal": "always", "close": false },
            "group": "build",
            "runOptions": { "instanceLimit": 1 }
        }
    ]
}
