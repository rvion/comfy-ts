{
   "editor.tabSize": 3,
   "editor.formatOnSave": true,
   "editor.defaultFormatter": "oxc.oxc-vscode",

   // THE key pair: auto-import inserts 'src/...' absolute specifiers, never './relative'
   "js/ts.preferences.importModuleSpecifier": "non-relative",
   "js/ts.preferences.importModuleSpecifierPreference": "non-relative",
   "typescript.preferences.importModuleSpecifier": "non-relative",

   // use the workspace typescript, not vscode's bundled one
   "js/ts.tsdk.path": "node_modules/typescript/lib",
   "typescript.tsdk": "node_modules/typescript/lib",

   // auto-imports emit `import type`
   "js/ts.preferences.preferTypeOnlyAutoImports": true,

   // kill junk suggestions
   "editor.suggest.showWords": false,
   "editor.wordBasedSuggestions": "off",

   // oxc lints + formats in-editor; formatter owns formatting, not tsserver
   "oxc.enable": true,
   "oxc.fmt.experimental": true,
   "eslint.enable": false,
   "js/ts.format.enabled": false,
   "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#3b053b",
      "activityBar.background": "#3b053b",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#585807",
      "activityBarBadge.foreground": "#e7e7e7",
      "activityBarTop.activeBackground": "#3b053b",
      "activityBarTop.background": "#3b053b",
      "activityBarTop.foreground": "#e7e7e7",
      "activityBarTop.inactiveForeground": "#e7e7e799",
      "commandCenter.border": "#e7e7e799",
      "commandCenter.foreground": "#e7e7e7",
      "sash.hoverBorder": "#3b053b",
      "statusBar.background": "#0c010c",
      "statusBar.debuggingBackground": "#0c010c",
      "statusBar.debuggingForeground": "#e7e7e7",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#3b053b",
      "statusBarItem.remoteBackground": "#585807",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#260426",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#0c010c99",
      "titleBar.inactiveForeground": "#e7e7e799"
   },
   "peacock.color": "#0c010c"
}
