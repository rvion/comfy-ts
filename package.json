{
   "name": "comfy-ts",
   "version": "2.24.0",
   "description": "An efficient way to create, run, maintain and operate your ComfyUI workflows, for humans and agents. A TypeScript SDK typed from your own install, with a CLI, a terminal UI, a web panel and a guide for coding agents.",
   "keywords": [
      "comfyui",
      "generative-ai",
      "typescript",
      "type-safe",
      "sdk",
      "codegen",
      "image-generation",
      "video-generation",
      "audio-generation",
      "3d",
      "stable-diffusion",
      "flux",
      "workflow",
      "cli",
      "tui"
   ],
   "author": "Rémi Vion <vion.remi@gmail.com>",
   "license": "MIT",
   "funding": "https://github.com/sponsors/rvion",
   "repository": {
      "type": "git",
      "url": "https://github.com/rvion/comfy-ts.git"
   },
   "bugs": {
      "url": "https://github.com/rvion/comfy-ts/issues"
   },
   "homepage": "https://github.com/rvion/comfy-ts",
   "type": "module",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "bin": {
      "comfy-ts": "./dist/cli.js"
   },
   "exports": {
      ".": {
         "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
         },
         "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
         }
      },
      "./web": {
         "import": {
            "types": "./dist/web.d.ts",
            "default": "./dist/web.js"
         }
      },
      "./src/*": "./src/*"
   },
   "files": [
      "dist",
      "src",
      "examples",
      "extra",
      "README.md",
      "guide-for-agents.md",
      "claude-code",
      "LICENSE"
   ],
   "scripts": {
      "build": "bun scripts/build.ts",
      "check:package": "bun scripts/check-package.ts",
      "test": "bun test --parallel --no-isolate",
      "test:raw": "bun test",
      "test:watch": "bun test --watch",
      "typecheck": "bun check -p tsconfig.lib.json && bun check -p tsconfig.tests.json && bun check -p examples/web/tsconfig.json && bun check -p src/cli/serve/web/tsconfig.json",
      "typecheck:full": "bun check -p tsconfig.json && bun check -p tsconfig.tests.json && bun check -p examples/web/tsconfig.json && bun check -p src/cli/serve/web/tsconfig.json && bun check -p examples/depth-explorer/web/tsconfig.json && bun check -p examples/world-explorer/web/tsconfig.json && bun check -p examples/upscale-explorer/web/tsconfig.json",
      "lint": "bun lint --no-script --max-warnings=0",
      "imports:check": "rvt imports --check",
      "imports:fix": "rvt imports --fix",
      "cycles": "rvt cycles 1",
      "rename": "rvt rename",
      "ci": "bun run typecheck && bun run lint && bun run imports:check && bun run test",
      "ci:local": "bun run ci && bun run typecheck:full",
      "gen:manager": "bun src/manager/script-update-manager.bun.ts",
      "gen:sdk": "bun scripts/gen-sdk-from-cache.ts",
      "gen:sdk:cloud": "bun src/cli/comfy-ts-cli.ts gen --id comfy-cloud --host https://cloud.comfy.org --out examples/comfy-cloud/sdk.d.ts",
      "sdk:outline": "bun scripts/sdk-outline.ts",
      "loras": "bun src/cli/comfy-ts-cli.ts loras",
      "examples:images": "bun scripts/fetch-example-images.ts",
      "gen:favicon": "bun scripts/gen-favicon.ts",
      "templates:fetch": "bun scripts/fetch-templates.ts",
      "templates:check": "bun scripts/check-templates.ts",
      "hooks:install": "git config core.hooksPath .githooks",
      "release": "bun scripts/release.ts",
      "release:dry": "bun scripts/release.ts --dry-run",
      "prepublishOnly": "bun run ci && bun run build",
      "tui": "bun src/cli/comfy-ts-cli.ts tui",
      "serve": "bun src/cli/comfy-ts-cli.ts serve",
      "serve:watch": "bun --watch src/cli/comfy-ts-cli.ts serve",
      "serve:0000": "bun src/cli/comfy-ts-cli.ts serve --host 0.0.0.0",
      "serve:0000:rvion": "bun src/cli/comfy-ts-cli.ts serve --host 0.0.0.0 examples/rvion",
      "serve:rvion": "bun --watch src/cli/comfy-ts-cli.ts serve examples/rvion",
      "depth": "bun examples/depth-explorer/serve.ts",
      "world": "bun --watch examples/world-explorer/serve.ts",
      "upscale": "bun examples/upscale-explorer/serve.ts",
      "check:panel-scroll": "bun scripts/check-panel-scroll.ts"
   },
   "rvt": {
      "skip": [
         ".shipkit/private",
         "tmp",
         ".comfy-ts"
      ]
   },
   "engines": {
      "bun": ">=1.1.0",
      "node": ">=22.0.0"
   },
   "dependencies": {
      "@codemirror/autocomplete": "^6.20.4",
      "@codemirror/commands": "^6.11.2",
      "@codemirror/state": "^6.7.6",
      "@codemirror/view": "^6.44.2",
      "@floating-ui/react": "^0.27.20",
      "arktype": "^2.2.10",
      "image-meta": "^0.3.1",
      "ink": "^8.0.0",
      "mobx": "^7.1.8",
      "mobx-react-lite": "^5.1.4",
      "nanoid": "^6.0.2",
      "pathe": "^2.0.3",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "react-resizable-panels": "^4.26.0",
      "sharp": "^0.35.5",
      "ws": "^8.23.1"
   },
   "devDependencies": {
      "@types/bun": "^1.4.5",
      "@types/react": "^19.3.3",
      "@types/react-dom": "^19.3.0",
      "@types/ws": "^8.18.2",
      "rvlib-shipkit": "^2.30.0",
      "rvlib-ts-tools": "^0.3.3"
   }
}
