{
   "name": "comfy-ts",
   "version": "2.6.0",
   "description": "The complete TypeScript toolkit for ComfyUI and generative AI. Fully type-safe SDK with autocomplete on every node, companion CLI, TUI, agentic docs, and 50+ examples. Design, run and deploy creative pipelines for image, video, audio, 3d and text on any ComfyUI, local, cloud or hosted.",
   "keywords": [
      "comfyui",
      "generative-ai",
      "typescript",
      "type-safe",
      "sdk",
      "codegen",
      "image-generation",
      "video-generation",
      "audio-generation",
      "3d",
      "stable-diffusion",
      "flux",
      "workflow",
      "cli",
      "tui"
   ],
   "author": "Rémi Vion <vion.remi@gmail.com>",
   "license": "MIT",
   "funding": "https://github.com/sponsors/rvion",
   "repository": {
      "type": "git",
      "url": "https://github.com/rvion/comfy-ts.git"
   },
   "bugs": {
      "url": "https://github.com/rvion/comfy-ts/issues"
   },
   "homepage": "https://github.com/rvion/comfy-ts",
   "type": "module",
   "main": "./dist/index.cjs",
   "module": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "bin": {
      "comfy-ts": "./dist/cli.js"
   },
   "exports": {
      ".": {
         "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
         },
         "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
         }
      },
      "./web": {
         "import": {
            "types": "./dist/web.d.ts",
            "default": "./dist/web.js"
         }
      },
      "./src/*": "./src/*"
   },
   "files": [
      "dist",
      "src",
      "examples",
      "README.md",
      "guide-for-agents.md",
      "LICENSE"
   ],
   "scripts": {
      "build": "tsdown && bun scripts/build-serve-web.ts",
      "build:watch": "tsdown --watch",
      "test": "bun test",
      "test:watch": "bun test --watch",
      "typecheck": "tsc --noEmit && tsc -p examples/web/tsconfig.json",
      "typecheck:lib": "tsc -p tsconfig.lib.json && tsc -p src/cli/serve/web/tsconfig.json",
      "lint": "oxlint src examples scripts tests",
      "format": "oxfmt src examples scripts tests",
      "format:check": "oxfmt --check src examples scripts tests",
      "imports:check": "rvt imports --check",
      "imports:fix": "rvt imports --fix",
      "cycles": "rvt cycles 1",
      "rename": "rvt rename",
      "ci": "bun run typecheck:lib && bun run lint && bun run format:check && bun run imports:check && bun test",
      "ci:local": "bun run ci && bun run typecheck",
      "gen:manager": "bun src/manager/script-update-manager.bun.ts",
      "gen:sdk": "bun scripts/gen-sdk-from-cache.ts",
      "gen:sdk:cloud": "bun src/cli/comfy-ts-cli.ts gen --id comfy-cloud --host https://cloud.comfy.org --out examples/comfy-cloud/sdk.d.ts && oxfmt examples/comfy-cloud/sdk.d.ts",
      "sdk:outline": "bun scripts/sdk-outline.ts",
      "loras": "bun src/cli/comfy-ts-cli.ts loras",
      "examples:images": "bun scripts/fetch-example-images.ts",
      "templates:fetch": "bun scripts/fetch-templates.ts",
      "templates:check": "bun scripts/check-templates.ts",
      "hooks:install": "git config core.hooksPath .githooks",
      "release": "bun scripts/release.ts",
      "release:dry": "bun scripts/release.ts --dry-run",
      "prepublishOnly": "bun run ci && bun run build",
      "tui": "bun src/cli/comfy-ts-cli.ts tui",
      "serve": "bun src/cli/comfy-ts-cli.ts serve",
      "serve:watch": "bun src/cli/comfy-ts-cli.ts serve"
   },
   "rvt": {
      "skip": [
         ".rv-private",
         "tmp",
         ".comfy-ts"
      ]
   },
   "engines": {
      "bun": ">=1.1.0",
      "node": ">=20.0.0"
   },
   "dependencies": {
      "arktype": "^2.2.3",
      "image-meta": "^0.2.2",
      "ink": "^7.1.1",
      "mobx": "^7.0.0",
      "mobx-react-lite": "^5.0.0",
      "nanoid": "^6.0.0",
      "pathe": "^2.0.3",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sharp": "^0.35.3",
      "ws": "^8.21.1"
   },
   "devDependencies": {
      "@types/bun": "^1.3.14",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@types/ws": "^8.18.1",
      "oxfmt": "^0.60.0",
      "oxlint": "^1.75.0",
      "oxlint-tsgolint": "^7.0.2001",
      "rvlib-ts-tools": "^0.3.3",
      "tsdown": "^0.22.14",
      "typescript": "^7.0.2"
   }
}
