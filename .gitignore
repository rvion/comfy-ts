node_modules
tsconfig.tsbuildinfo
/docs/
# build output: npm gets it from prepublishOnly, git never needs it
dist/

# scratch: run logs, plan docs, throwaway scripts (the '.tmp/tmp/' pattern
# this replaces matched neither of them)
tmp/
.tmp/

# local working dirs, never published: the engineering journal (the full
# blow-by-blow behind each change), transient reflections, unpublished social
# and site copy. The PUBLIC record is CHANGELOG.md.
.rv-journal/
# repo-local scratch + hazards (ssh keypair, banned-keyword list, throwaway
# scripts): OUTSIDE src/ on purpose, so no packaging whitelist can reach it
.rv-private/
.rv-reflections/
.rv-social/
.rv-rvion-fr/
# machine-local agent context, imported by CLAUDE.md when present and simply
# absent for everyone else
CLAUDE.local.md

# EVERYTHING under .comfy-ts/ is local machine state and never this repo's
# business: host dumps (that machine's whole model inventory and its paths,
# ~10MB, from `bun run gen:sdk`), the lora metadata mirror, generated outputs,
# TUI drafts and settings, hand-tuned lora keywords, image-picker prefs, the
# preview cache, the mirrored upstream templates. Ignored WHOLESALE, not path by
# path: a deny-list only covers what exists today, so the next feature to write
# there would be tracked by default. Negate a single path here if one ever needs
# to be committed.
.comfy-ts/
# a captured model-manager page describes ONE machine's collection (absolute
# disk paths, content ratings, remote ids, the full inventory): never committed,
# from anywhere in the tree. Fixtures under tests/ are SYNTHETIC and stay that
# way — tests/no-personal-lora-data.test.ts fails the build if any slips in.
*.captured.json
