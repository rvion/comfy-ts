# comfy-ts, the announcement cut: what it is in the first seconds (your ComfyUI as TypeScript types), then one
# command, then the name and where to get it. Every shot is the product: a real editor over the real types, a real
# terminal session replayed byte for byte, a real output. The titles carry every claim (feeds play muted), the
# narrator says the same beat in other words.
trailer comfy-ts
size 1280x720
fps 30
master -14 LUFS
duck -9dB
# the cut's titles: a beat's claim in the band above the product, the name in the corner, the end card's name
preset claim font "Inter" weight 800 size 74 color #eaf1ff place top in rise out fade
preset mark font "JetBrains Mono" weight 700 size 46 in none out none
preset name font "Inter" weight 800 size 150 color #eaf1ff sub 0.3 in pop

score tempo 100 reverb 2.2 0.26
track sub sub volume 0.55
track pad pad volume 0.42
track pad2 pad volume 0.36
track pad3 pad volume 0.32
track arp arp volume 0.34
track bass bassPulse volume 0.5
track kick kick volume 0.8
track hat hat volume 0.32
track clap clap volume 0.5
track bell bell volume 0.5

code
  const BAR = 16
  /** n bars of silence */
  const vide = (n: number) => rest(n * BAR)
  /** the three pad voices of a chart */
  const pads = (ch: string) => ({ pad: voice(ch, 0, 53), pad2: voice(ch, 1, 57), pad3: voice(ch, 2, 60) })
  /** four on the floor, n bars */
  const four = (n: number) => rep('k - - - ', 4 * n)
  /** the hat on the off beats, n bars */
  const offs = (n: number) => rep('- - h - ', 4 * n)
  /** a clap on beats two and four, n bars */
  const backs = (n: number) => rep('- - - - c - - - - - - - c - - - ', n)

drums k=kick h=hat c=clap

# the editor: a soft pulse and the arpeggio, rising; the hat comes in on the third beat
section intro 6bars tempo 100
  play * ({ ...pads('Fmaj7 | Am7 | Dm9 | Bbmaj7 | Fmaj7 | C'), sub: bass('Fmaj7 | Am7 | Dm9 | Bbmaj7 | Fmaj7 | C', 'hold', 2) })
  play arp arp('Fmaj7 | Am7 | Dm9 | Bbmaj7 | Fmaj7 | C', [0, 1, 2, 3, 2, 1], 5, 2)
  play hat seq(vide(4), offs(2))
shot editor 6bars
  film run "bun trailer/comfy-ts/film/page.ts editor/index.html {seconds} {out}" reads editor/index.html,editor/kit.js,editor/take.js,film/page.ts
  title "comfy-ts" for 6bars style corner +mark
  title "Your ComfyUI, *typed*" at 0.25s for 3.9s style line +claim
  title "Your models, *autocompleted*" at 2bars for 4.1s style line +claim
  title "Wrong name? *Compile error*" at 4bars for 4.3s style line +claim place bottom
  voice run "bun trailer/comfy-ts/film/voice.ts 'Comfy T.S. turns your ComfyUI into TypeScript.' {out}" reads film/voice.ts at 0.3s
  voice run "bun trailer/comfy-ts/film/voice.ts 'Every node and every model autocompletes.' {out}" reads film/voice.ts at 2bars+0.3s
  voice run "bun trailer/comfy-ts/film/voice.ts 'A wrong name is a compile error.' {out}" reads film/voice.ts at 4bars+0.6s
  cut whip-left 0.5beat

# one command: the groove lands with the enter key
section run 3bars tempo 100
  play * ({ ...pads('Dm9 | Bbmaj7 | C'), bass: bass('Dm9 | Bbmaj7 | C', 'octave', 2), kick: four(3), hat: offs(3), clap: backs(3) })
  play arp arp('Dm9 | Bbmaj7 | C', [0, 1, 2, 3], 5, 2)
shot run 3bars
  film run "bun trailer/comfy-ts/film/page.ts term/index.html {seconds} {out} cast=casts/run.cast from=0.3 speed=1.12 idle=0.6 title=my-project" reads term/index.html,term/replay.js,film/page.ts,casts/run.cast
  title "One command, one *image*" at 0.2s for 6.1s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'One command runs it.' {out}" reads film/voice.ts at 0.4s
  cut fade 0.5beat

# the image it made: air, the voice rests
section result 2bars tempo 100
  play * ({ ...pads('Fmaj7 | Am7'), sub: bass('Fmaj7 | Am7', 'hold', 2), hat: offs(2) })
  play arp arp('Fmaj7 | Am7', [0, 2, 3, 2], 5, 2)
shot result 2bars
  film image media/lighthouse.png
  push 1.08
  title "made in 1.4 s" at 0.6s for 3.4s style corner +mark
  cut fade 0.5beat

# vars and ifs make the workflow an app: the staged file gains two of each, typed until it reads as the file on disk
section app 4bars tempo 100
  play * ({ ...pads('Fmaj7 | Am7 | Dm9 | Bbmaj7'), sub: bass('Fmaj7 | Am7 | Dm9 | Bbmaj7', 'hold', 2), hat: offs(4) })
  play arp arp('Fmaj7 | Am7 | Dm9 | Bbmaj7', [0, 1, 2, 3, 2, 1], 5, 2)
shot app 4bars
  film run "bun trailer/comfy-ts/film/page.ts editor/index.html {seconds} {out} take=app" reads editor/index.html,editor/kit.js,editor/app.js,stage/scenery.cflow.ts,film/page.ts
  title "Vars and ifs make an *app*" at 0.2s for 9.2s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'Add a variable and an if. Your workflow is now an app.' {out}" reads film/voice.ts at 0.4s
  cut whip-left 0.5beat

# the same file, run as an app: --help lists every var as a flag, then the flags run it
section appterm 3bars tempo 100
  play * ({ ...pads('Dm9 | Bbmaj7 | C'), bass: bass('Dm9 | Bbmaj7 | C', 'octave', 2), kick: four(3), hat: offs(3), clap: backs(3) })
  play arp arp('Dm9 | Bbmaj7 | C', [0, 1, 2, 3], 5, 2)
shot appterm 3bars
  film run "bun trailer/comfy-ts/film/page.ts term/index.html {seconds} {out} cast=casts/app.cast from=0.3 speed=1.5 idle=0.5 title=my-project" reads term/index.html,term/replay.js,film/page.ts,casts/app.cast
  title "Every var is a *flag*" at 0.2s for 6.8s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'Every variable is a flag.' {out}" reads film/voice.ts at 0.4s
  cut fade 0.5beat

# what the flags changed: the same seed at dusk and with --night
section appresult 2bars tempo 100
  play * ({ ...pads('Fmaj7 | Am7'), sub: bass('Fmaj7 | Am7', 'hold', 2), hat: offs(2) })
  play arp arp('Fmaj7 | Am7', [0, 2, 3, 2], 5, 2)
shot appresult 2bars
  film split dusk,night slide 0.3s
  title "--night --upscale" at 0.4s for 4s style corner +mark
  cut fade 0.5beat

# the TUI: the same workflow in the terminal, a reroll, the night toggle, the picture forming live
section tui 3bars tempo 100
  play * ({ ...pads('Dm9 | Bbmaj7 | C'), bass: bass('Dm9 | Bbmaj7 | C', 'octave', 2), kick: four(3), hat: offs(3), clap: backs(3) })
  play arp arp('Dm9 | Bbmaj7 | C', [0, 1, 2, 3], 5, 2)
shot tui 3bars
  film run "bun trailer/comfy-ts/film/page.ts term/index.html {seconds} {out} cast=casts/tui.cast from=10.6 speed=2 title=comfy-ts" reads term/index.html,term/replay.js,film/page.ts,casts/tui.cast
  title "Tweak, rerun, *watch*" at 0.2s for 6.8s style line +claim
  title "2x speed" at 0.2s for 6.8s style corner +mark
  voice run "bun trailer/comfy-ts/film/voice.ts 'Tweak it in the terminal, and watch it form.' {out}" reads film/voice.ts at 0.4s
  cut fade 0.5beat

# the web panel: the same vars as fields, a prompt typed, a run with live progress
section panel 3bars tempo 100
  play * ({ ...pads('Fmaj7 | Am7 | Bbmaj7'), bass: bass('Fmaj7 | Am7 | Bbmaj7', 'octave', 2), kick: four(3), hat: offs(3), clap: backs(3) })
  play arp arp('Fmaj7 | Am7 | Bbmaj7', [0, 1, 2, 3], 5, 2)
shot panel 3bars
  film run "bun trailer/comfy-ts/film/panel.ts {seconds} {out}" reads film/panel.ts,stage/scenery.cflow.ts
  title "Or in your *browser*" at 0.2s for 6.8s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'Or in the browser, every variable a field.' {out}" reads film/voice.ts at 0.4s
  cut whip-left 0.5beat

# an agent: one sentence asked in a real Claude Code session, the agent reads the guide and runs the workflow
section agent 4bars tempo 100
  play * ({ ...pads('Dm9 | Bbmaj7 | Fmaj7 | C'), bass: bass('Dm9 | Bbmaj7 | Fmaj7 | C', 'octave', 2), kick: four(4), hat: offs(4), clap: backs(4) })
  play arp arp('Dm9 | Bbmaj7 | Fmaj7 | C', [0, 1, 2, 3], 5, 2)
shot agent 4bars
  film run "bun trailer/comfy-ts/film/page.ts term/index.html {seconds} {out} cast=casts/claude.cast from=3.6 speed=3.35 title=my-project" reads term/index.html,term/replay.js,film/page.ts,casts/claude.cast
  title "Agents drive it *too*" at 0.2s for 9.2s style line +claim
  title "3x speed" at 0.2s for 9.2s style corner +mark
  voice run "bun trailer/comfy-ts/film/voice.ts 'Ask an agent. It reads one guide and runs it.' {out}" reads film/voice.ts at 0.6s
  cut fade 0.5beat

# what it makes: real outputs, each made by comfy-ts on a local GPU
section outputs 2bars tempo 100
  play * ({ ...pads('Dm9 | Bbmaj7'), bass: bass('Dm9 | Bbmaj7', 'octave', 2), kick: four(2), hat: offs(2), clap: backs(2) })
  play arp arp('Dm9 | Bbmaj7', [0, 1, 2, 3], 5, 2)
shot outputs 2bars
  film grid fox,bookshop,day,songwave pop 0.12s
  title "Photos, art, *songs*" at 0.2s for 4.4s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'Photos, art, songs.' {out}" reads film/voice.ts at 0.4s
  cut whip-left 0.5beat

# the zoo: every bundled workflow scrolls past, the cloud catalog's 73 among them
section zoo 2bars tempo 100
  play * ({ ...pads('Bbmaj7 | C'), bass: bass('Bbmaj7 | C', 'octave', 2), kick: four(2), hat: offs(2), clap: backs(2) })
  play arp arp('Bbmaj7 | C', [0, 1, 2, 3], 5, 2)
shot zoo 2bars
  film run "bun trailer/comfy-ts/film/page.ts term/index.html {seconds} {out} cast=casts/list.cast from=1.0 trickle=24 title=my-project" reads term/index.html,term/replay.js,film/page.ts,casts/list.cast
  title "*73* ready workflows" at 0.2s for 4.4s style line +claim
  voice run "bun trailer/comfy-ts/film/voice.ts 'Seventy-three ready workflows.' {out}" reads film/voice.ts at 0.4s
  cut dip-black 1beat

# the name and where to get it; the music stops dead and one note rings alone
section end 3bars tempo 100
  play * ({ ...pads('Bbmaj7 | C | Fmaj7'), sub: bass('Bbmaj7 | C | Fmaj7', 'hold', 2) })
  play bell seq('v9:A5 . . . C6 . . . E6 . . . . . . .', 'v9:G5 . . . . . . . C6 . . . . . . .', 'v10:F5', rep('.', 15))
  stop at 2bars+2beats
shot end 3bars
  film run "bun trailer/comfy-ts/film/page.ts card/index.html {seconds} {out}" reads card/index.html,film/page.ts
  title "comfy-ts\nyour ComfyUI, typed" at 0.2s style big place middle +name
  title "bun add comfy-ts\ngithub.com/rvion/comfy-ts" at 1bar style caption place bottom font "JetBrains Mono" weight 700 color #ffb020
  voice run "bun trailer/comfy-ts/film/voice.ts 'Comfy T.S. Free and open source.' {out}" reads film/voice.ts at 1bar
  sfx run "ffmpeg -v error -f lavfi -i sine=f=1396.9:d=1.4 -af afade=t=out:st=0.02:d=1.38,volume=0.5 {out}" at 2bars+2beats
  cut dip-black 1beat

footage dusk 4.8s
  film run "bun trailer/comfy-ts/film/still.ts trailer/comfy-ts/media/lighthouse.png {seconds} {out} {w} {h} {fps}" reads media/lighthouse.png,film/still.ts
footage night 4.8s
  film run "bun trailer/comfy-ts/film/still.ts trailer/comfy-ts/media/night.png {seconds} {out} {w} {h} {fps}" reads media/night.png,film/still.ts
footage fox 4.8s
  film run "bun trailer/comfy-ts/film/still.ts trailer/comfy-ts/media/fox.png {seconds} {out} {w} {h} {fps}" reads media/fox.png,film/still.ts
footage bookshop 4.8s
  film run "bun trailer/comfy-ts/film/still.ts trailer/comfy-ts/media/bookshop.png {seconds} {out} {w} {h} {fps}" reads media/bookshop.png,film/still.ts
footage day 4.8s
  film run "bun trailer/comfy-ts/film/still.ts trailer/comfy-ts/media/lighthouse-day.png {seconds} {out} {w} {h} {fps}" reads media/lighthouse-day.png,film/still.ts
footage songwave 4.8s
  film run "bun trailer/comfy-ts/film/waves.ts trailer/comfy-ts/media/song-cut.wav {seconds} {out} {w} {h} {fps}" reads media/song-cut.wav,film/waves.ts
