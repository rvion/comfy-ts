{
   // the second dom-typed corner (examples/web is the first): this app runs in
   // a browser. src/ elsewhere stays dom-free by machine — this dir is excluded
   // from the root config and chained into `typecheck:lib`
   "extends": "../../../../tsconfig.json",
   "compilerOptions": {
      "lib": ["ESNext", "DOM", "DOM.Iterable"],
      "paths": {
         "src/*": ["../../../../src/*"],
         "comfy-ts": ["../../../../src/index.ts"]
      },
      "tsBuildInfoFile": "../../../../node_modules/.cache/tsbuildinfo-serve-web.json"
   },
   // MUST override the root's exclude: it lists this very directory (so the dom-free
   // rule holds there), and `extends` would otherwise make this config exclude the only
   // files it exists to check, the app went unchecked until tests/tsconfig-covers.test.ts
   "exclude": ["../../../../examples/web"],
   "include": [".", "../../../../src"]
}
