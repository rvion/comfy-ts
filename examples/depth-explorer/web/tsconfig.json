{
   // the depth explorer page: dom-typed like examples/web, so it keeps its own config. It renders
   // the panel's relight widget, so it checks src/ too, like src/cli/serve/web does
   "extends": "../../../tsconfig.json",
   "compilerOptions": {
      "lib": ["ESNext", "DOM", "DOM.Iterable"],
      "paths": {
         "src/*": ["../../../src/*"],
         "comfy-ts": ["../../../src/index.ts"]
      },
      "tsBuildInfoFile": "../../../node_modules/.cache/tsbuildinfo-depth-explorer-web.json"
   },
   // MUST override the root's exclude, which lists this directory
   "exclude": ["../../web"],
   "include": [".", "../../../src"]
}
