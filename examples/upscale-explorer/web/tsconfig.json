{
   // the upscale explorer page: dom-typed like examples/web, so it keeps its own config; the
   // explorer kit's web files come in through its imports
   "extends": "../../../tsconfig.json",
   "compilerOptions": {
      "lib": ["ESNext", "DOM", "DOM.Iterable"],
      "paths": {
         "src/*": ["../../../src/*"],
         "comfy-ts": ["../../../src/index.ts"]
      }
   },
   // MUST override the root's exclude, which lists this directory
   "exclude": ["../../web"],
   "include": ["."]
}
